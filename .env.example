# SimpliSafe OAuth refresh token, minted by the one-time browser login:
#   node scripts/bootstrap-auth.mjs            # step 1: prints an authorize URL
#   node scripts/bootstrap-auth.mjs "<url>"    # step 2: exchanges the code
#
# SimpliSafe issues no API keys — this token IS the credential, and it grants
# full control of the alarm system. Treat it like a password. It is not rotated
# by SimpliSafe, so it stays valid until you sign out of all devices in the app.
SIMPLISAFE_REFRESH_TOKEN=

# The exchanged access/refresh pair is cached on disk (0600) so a restart does
# not re-authenticate. Set to false to turn that off.
# SIMPLISAFE_TOKEN_CACHE=false

# Where that cache lives.
# Defaults to $MCP_DATA_DIR/.simplisafe-mcp/token.json
# SIMPLISAFE_TOKEN_FILE=/path/to/token.json
